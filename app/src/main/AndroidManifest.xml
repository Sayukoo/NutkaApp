<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <!-- The transcription upload keeps the same service in the foreground once
         the mic is released; that phase is a data-sync foreground service. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- Keeps the CPU running while recording with the screen off. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Lets Settings offer the "ignore battery optimisations" prompt, which is
         what stops aggressive OEM power managers from killing a long session. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- Reading audio files out of the shared Downloads folder. Split by API
         level: READ_MEDIA_AUDIO replaced the blanket storage permission in 33. -->
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!-- Call-state changes (off-hook / idle) for the phone-call recorder.
         Only the state — the caller's number would need READ_CALL_LOG, which
         the recorder doesn't use. -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />

    <uses-feature
        android:name="android.hardware.microphone"
        android:required="true" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:theme="@style/Theme.Nutka"
        android:supportsRtl="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Nutka.Splash"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- stopWithTask=false: swiping Nutka out of the recents list must not
             end a recording that is still running. -->
        <service
            android:name=".service.RecordingService"
            android:exported="false"
            android:stopWithTask="false"
            android:foregroundServiceType="microphone|dataSync" />

        <!-- Phone-call recorder. Must be switched on by the user in the system
             accessibility settings: that is what Android requires before it lets
             a non-system app hear the microphone during a call. It reads no
             screen content (see call_recording_accessibility.xml). -->
        <service
            android:name=".service.CallRecordingAccessibilityService"
            android:exported="false"
            android:label="@string/call_accessibility_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/call_recording_accessibility" />
        </service>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>
</manifest>
