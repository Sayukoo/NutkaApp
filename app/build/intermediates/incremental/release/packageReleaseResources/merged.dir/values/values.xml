<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="accent">#C67139</color>
    <color name="bg">#F5EAD8</color>
    <color name="ic_launcher_background">#C67139</color>
    <color name="ink">#201E1D</color>
    <string name="app_name">Nutka</string>
    <style name="Theme.Nutka" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
    <style name="Theme.Nutka.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/bg</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="postSplashScreenTheme">@style/Theme.Nutka</item>
    </style>
</resources>